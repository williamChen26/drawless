{
  "name": "@drawless/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @drawless/shared build && pnpm --filter @drawless/ui build && next build",
    "dev": "NEXT_PUBLIC_DRAWLESS_SYNC_SERVER_URL=http://127.0.0.1:3001 next dev --hostname 127.0.0.1",
    "start": "next start",
    "test:unit": "vitest run src/lib/_spec",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drawless/shared": "workspace:*",
    "@drawless/ui": "workspace:*",
    "@tldraw/sync": "5.0.1",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "5.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
