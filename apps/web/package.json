{
  "name": "@drawless/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @drawless/shared build && pnpm --filter @drawless/ui build && next build",
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start",
    "test:unit": "vitest run src/lib/_spec",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drawless/shared": "workspace:*",
    "@drawless/ui": "workspace:*",
    "@tldraw/sync": "5.0.1",
    "motion": "^12.43.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldraw": "5.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
