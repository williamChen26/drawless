# 本机开发可省略；公开部署时 web 与 server 必须使用同一随机密钥（至少 32 字符）。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DRAWLESS_ROOM_ACCESS_SECRET=
NEXT_PUBLIC_DRAWLESS_SYNC_SERVER_URL=http://127.0.0.1:3001
NEXT_PUBLIC_DRAWLESS_SERVER_URL=http://127.0.0.1:3001
NEXT_PUBLIC_DRAWLESS_SYNC_ROUTE=/sync
# 生产部署使用部署者自己的 tldraw key；它是公开前端配置，不是服务端密钥。
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
