# 本地开发默认连接本机 drawless server。
NEXT_PUBLIC_DRAWLESS_SYNC_SERVER_URL=http://127.0.0.1:3001
NEXT_PUBLIC_DRAWLESS_SERVER_URL=http://127.0.0.1:3001

