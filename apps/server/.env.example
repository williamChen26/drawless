# 本地开发默认只监听本机。
HOST=127.0.0.1
PORT=3001
SYNC_ROUTE=/sync
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 本地默认不启用 coworker 控制面。
COWORKER_ENABLED=false
COWORKER_BASE_URL=http://127.0.0.1:4111
SERVER_PUBLIC_URL=http://127.0.0.1:3001
COWORKER_REQUEST_TIMEOUT_MS=10000

# Railway 部署时建议使用以下形态，PORT 由 Railway 自动注入，不要手动填写。
# HOST=0.0.0.0
# SYNC_ROUTE=/sync
# COWORKER_ENABLED=true
# COWORKER_BASE_URL=https://你的-coworker域名
# SERVER_PUBLIC_URL=https://你的-server域名
# ALLOWED_ORIGINS=https://你的-web域名
