HOST=127.0.0.1
PORT=3001
SYNC_ROUTE=/sync
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# HOST 非本机或 NODE_ENV=production 时必填，至少 32 字符，与 web 相同。
DRAWLESS_ROOM_ACCESS_SECRET=
# 仅列出实际可信代理的 IP/CIDR；不配置时忽略 X-Forwarded-For。
TRUSTED_PROXIES=
COWORKER_ENABLED=false
COWORKER_BASE_URL=http://127.0.0.1:4111
# 必须与 runtime 的 DRAWLESS_SYNC_SERVER_URL 一致。
SERVER_PUBLIC_URL=http://127.0.0.1:3001
# 公开部署启用 coworker 时必填，与 runtime 相同，至少 32 字符。
COWORKER_CONTROL_TOKEN=
COWORKER_REQUEST_TIMEOUT_MS=10000
# 反馈默认关闭；启用后发送到部署者自己的 GitHub 仓库。
FEEDBACK_ENABLED=false
GITHUB_FEEDBACK_REPOSITORY=
GITHUB_FEEDBACK_TOKEN=
FEEDBACK_REQUEST_TIMEOUT_MS=5000
