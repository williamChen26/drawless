HOST=127.0.0.1
PORT=4111
# 仅允许连接这一 sync 服务，必须与 server 的 SERVER_PUBLIC_URL 一致。
DRAWLESS_SYNC_SERVER_URL=http://127.0.0.1:3001
# 公开部署必填，与 server 相同，至少 32 字符。
COWORKER_CONTROL_TOKEN=
# 现有模型固定为 deepseek/deepseek-chat；仅启用 AI 时需要真实 key。
DEEPSEEK_API_KEY=
# 默认 memory；file 会持久保存对话，需由部署者管理保留与删除策略。
COWORKER_STORAGE_MODE=memory
# 默认不记录模型追踪，不发送远端 trace。
COWORKER_OBSERVABILITY_ENABLED=false
